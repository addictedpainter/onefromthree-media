    {
      "title": "Ton Roosendaal to step down as Blender chairman and CEO",
      "url": "https://www.cgchannel.com/2025/09/ton-roosendaal-to-step-down-as-blender-chairman-and-ceo/",
      "publisher": "CG Channel (Jim Thacker)",
